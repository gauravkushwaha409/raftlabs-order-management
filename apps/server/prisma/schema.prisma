generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  orders        Order[]
  notifications Notification[]
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String
  priceCents  Int
  image       String
  category    String
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id           String      @id @default(uuid())
  customerName String
  address      String
  phone        String
  status       OrderStatus @default(RECEIVED)
  totalCents   Int
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// name/priceCents are snapshots taken at order time so later menu edits never change past orders.
model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name       String
  priceCents Int
  quantity   Int

  @@index([orderId])
}

// Transactional outbox: written in the same transaction as the state change it describes, then
// relayed to Kafka by the worker and deleted. Guarantees an event exists iff the change committed.
// `seq` fixes the relay order; `aggregateId` becomes the Kafka key so one order's events stay ordered.
model OutboxEvent {
  id          String   @id @default(uuid())
  seq         Int      @unique @default(autoincrement())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime @default(now())
}

// Written by the notifications consumer. `eventId` is unique so a redelivered Kafka message is a no-op.
model Notification {
  id        String    @id @default(uuid())
  eventId   String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
