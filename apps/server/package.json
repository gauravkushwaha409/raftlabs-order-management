{
	"name": "server",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
		"start": "node dist/main.js",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"resource": "nest generate resource"
	},
	"dependencies": {
		"@nestjs/common": "^12.1.3",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.1.3",
		"@nestjs/platform-express": "^12.1.3",
		"@nestjs/platform-socket.io": "^12.1.3",
		"@nestjs/swagger": "^12.0.2",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/websockets": "^12.1.3",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"dotenv": "^18.0.7",
		"ioredis": "^6.0.0",
		"nestjs-zod": "^5.5.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.8",
		"@nestjs/schematics": "^12.0.7",
		"@nestjs/testing": "^12.1.3",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.4",
		"concurrently": "^10.0.6",
		"prisma": "^7.10.0",
		"supertest": "^7.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
