# ─── Environment template ───────────────────
# Copy to env/.env.<environment> (development | production).
# Those files are gitignored; only this template is committed.
#   - pnpm dev / vite dev   -> env/.env.development (vite mode "development")
#   - server, prisma        -> env/.env.${APP_ENV:-development}
#   - docker                -> pnpm docker:<environment>:* (env_file + --env-file)
APP_ENV=development

# ─── Ports (single source of truth) ─────────
SERVER_PORT=8000
APP_PORT=3000
ADMIN_PORT=3001

# ─── Postgres ───────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=raftlabs
POSTGRES_PORT=5434
# Host-run server (pnpm dev). Docker compose overrides host to "postgres".
DATABASE_URL=postgresql://admin:admin@localhost:5434/raftlabs

# ─── Redis ──────────────────────────────────
# Host-run server (pnpm dev). Docker compose overrides host to "redis".
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── CORS (comma separated, extra to APP/ADMIN urls) ───
CORS_ORIGINS=

# ─── Frontend (baked in at build time) ──────
VITE_SERVER_URL=http://localhost:${SERVER_PORT}
VITE_APP_URL=http://localhost:${APP_PORT}
VITE_ADMIN_URL=http://localhost:${ADMIN_PORT}
# true: vite proxies /api/v1 + /socket.io to VITE_SERVER_URL (dev only)
PROXY=true

# ─── Auth ───────────────────────────────────
# Signs session cookies. At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Demo accounts created on startup when missing (never overwritten afterwards). Outside production they
# fall back to these same values if unset; in production they are skipped unless both values are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=Customer@12345
# lax: apps and API on the same site. none: apps hosted on a different site than the API (forces Secure cookies).
COOKIE_SAME_SITE=lax
# Number of reverse proxies in front of the API, so rate limiting sees client IPs. Leave empty when none.
TRUST_PROXY=

# ─── Order simulation ───────────────────────
# Milliseconds between simulated status steps (RECEIVED -> PREPARING -> OUT_FOR_DELIVERY -> DELIVERED)
ORDER_STEP_MS=10000
