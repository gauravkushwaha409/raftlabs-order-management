# ─── Environment template ───────────────────
# Copy to env/.env.<environment> (development | production).
# Those files are gitignored; only this template is committed.
#   - pnpm dev / vite dev   -> env/.env.development (vite mode "development")
#   - server, prisma        -> env/.env.${APP_ENV:-development}
#   - docker                -> pnpm docker:<environment>:* (env_file + --env-file)
APP_ENV=development

# ─── Ports (single source of truth) ─────────
SERVER_PORT=8000
APP_PORT=3000
ADMIN_PORT=3001

# ─── Postgres ───────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=raftlabs
POSTGRES_PORT=5434
# Host-run server (pnpm dev). Docker compose overrides host to "postgres".
DATABASE_URL=postgresql://admin:admin@localhost:5434/raftlabs

# ─── Redis ──────────────────────────────────
# Host-run server (pnpm dev). Docker compose overrides host to "redis".
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── CORS (comma separated, extra to APP/ADMIN urls) ───
CORS_ORIGINS=

# ─── Frontend (baked in at build time) ──────
VITE_SERVER_URL=http://localhost:${SERVER_PORT}
VITE_APP_URL=http://localhost:${APP_PORT}
VITE_ADMIN_URL=http://localhost:${ADMIN_PORT}
# true: vite proxies /api/v1 + /socket.io to VITE_SERVER_URL (dev only)
PROXY=true

# ─── Admin + order simulation ───────────────
# Required by admin-only endpoints (send as x-admin-key). Use a long random value outside dev.
ADMIN_API_KEY=dev-admin-key-change-me
# Seconds-scale delay between simulated status steps (RECEIVED -> PREPARING -> OUT_FOR_DELIVERY -> DELIVERED)
ORDER_STEP_MS=10000
